<!-- Phase C (night contrast): primary buttons use primary_container bg in
     night mode. #002958 (oneui_button_text) on #418FFF = 4.52 (AA); white on
     night primary #0381FE is only 3.77. Day version keeps oneui_primary bg. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/oneui_on_primary_container">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/oneui_primary_container" />
            <corners android:radius="9999dp" />
        </shape>
    </item>
</ripple>
