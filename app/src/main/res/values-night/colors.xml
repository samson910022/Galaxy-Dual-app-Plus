<!-- p28-1 語意色（深色，假設背景 #121212 的數學驗證，非實際主題聲稱）：
     Manifest 未宣告 android:theme，實際 surface 未鎖定，故此處不聲稱實際主題對比。
     錯配風險：實際視窗背景隨裝置/系統而異，若偏離假設 #121212，上述比值不代表實際可讀性；
     實際 surface 對比驗證與主題綁定為 p28-3 範圍，本檔不新增實際對比聲稱。
     淺色前景色在假設深底對比不足
    （INFO 3.87、VERIFY/FAILED 2.87、CHANNEL 2.24，皆未達 4.5:1），故另給亮色（以下比值僅為對假設背景的數學檢查）：
     - msg_info #81C784（9.31:1）
     - msg_invalid #FFB74D（10.82:1）
     - msg_no_dual #FFCC80（12.67:1）
     - msg_verify/msg_failed #FF8A80（8.21:1）
     - msg_channel #CE93D8（7.84:1）
     完整主題（含實際 surface 綁定）為 p28-3 範圍，此處只定義訊息語意色。 -->
<resources>
    <!-- Legacy semantic colors for tests & msgView -->
    <color name="msg_info">#81C784</color>
    <color name="msg_invalid">#FFB74D</color>
    <color name="msg_no_dual">#FFCC80</color>
    <color name="msg_verify">#FF8A80</color>
    <color name="msg_failed">#FF8A80</color>
    <color name="msg_channel">#CE93D8</color>

    <!-- One UI 6 Dark/OLED Design Tokens -->
    <color name="oneui_canvas">#080B10</color>
    <color name="oneui_surface">#101319</color>
    <color name="oneui_surface_container_lowest">#0B0E13</color>
    <color name="oneui_surface_container_low">#191C21</color>
    <color name="oneui_surface_container">#121721</color>
    <color name="oneui_surface_container_high">#1B2230</color>
    <color name="oneui_surface_container_highest">#242C3D</color>

    <color name="oneui_primary">#0381FE</color>
    <color name="oneui_primary_tint">#AAC7FF</color>
    <color name="oneui_primary_container">#418FFF</color>
    <color name="oneui_on_primary">#FFFFFF</color>
    <color name="oneui_on_primary_container">#002958</color>

    <color name="oneui_secondary">#10B981</color>
    <color name="oneui_secondary_tint">#4EDEA3</color>
    <color name="oneui_secondary_container">#2610B981</color>
    <color name="oneui_on_secondary">#003824</color>

    <color name="oneui_warning">#F59E0B</color>
    <!-- Phase C: night warning container. #F59E0B on #2A1F0D = 7.52 (AA).
         Residual: warning text on light containers (light theme) still below
         4.5; tracked separately, not changed here. -->
    <color name="oneui_warning_container">#2A1F0D</color>
    <!-- Phase D: night warning *text* token (#F59E0B: 7.52 on warning_container
         #2A1F0D, >= 8.3 on dark surfaces; pairs with the amber pill bg and
         dark canvas. Value intentionally equals night oneui_warning today so
         text and decoration can diverge later). -->
    <color name="oneui_warning_text">#F59E0B</color>
    <!-- Phase C: night button/badge text. #002958 on primary_container
         #418FFF = 4.52 (AA). Night primary #0381FE intentionally NOT darkened:
         it passes as text on dark surfaces (4.76-5.23) while #0B6BDD would
         drop to 3.16-3.69. Night buttons/badges swap bg to primary_container
         (see drawable-night/bg_pill_button.xml, bg_dual_badge.xml). -->
    <color name="oneui_button_text">#002958</color>
    <color name="oneui_error">#EF4444</color>
    <color name="oneui_stroke_subtle">#66263044</color>
    <color name="oneui_divider">#99263044</color>

    <color name="oneui_text_primary">#E1E2EA</color>
    <color name="oneui_text_secondary">#C1C6D7</color>
    <color name="oneui_text_tertiary">#8B91A0</color>
</resources>
